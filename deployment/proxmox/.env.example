GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
SHAREPOINT_SITE_ID=<sharepoint-site-id>
SHAREPOINT_LIST_EMAIL_LOG=<email-log-list-id>
SHAREPOINT_LIST_DRAFT_LOG=<draft-log-list-id>
FLOW_DASHBOARD_IGNORE_URL=<private-flow-url>
FLOW_DASHBOARD_CLASSIFY_URL=<private-flow-url>
FLOW_DASHBOARD_REGENERATE_URL=<private-flow-url>
