# Copied to .env on the Proxmox VM. Never commit the real file.
DASHBOARD_HTTP_PORT=8080
DASHBOARD_API_PORT=8787
DASHBOARD_ORIGIN=http://localhost:8080
TENANT_ID=<entra-tenant-id>
CLIENT_ID=<entra-app-client-id>
